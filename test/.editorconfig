# Test projects
[*.cs]
# Test classes are public for xUnit, not a shipped API
dotnet_diagnostic.RS0016.severity = none
dotnet_diagnostic.RS0037.severity = none
# xUnit tests must keep the synchronization context (xUnit1030)
dotnet_diagnostic.MA0004.severity = none
# SQL in tests is built from constants
dotnet_diagnostic.CA2100.severity = none
